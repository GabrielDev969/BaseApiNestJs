# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=workspace_db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workspace_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# JWT
JWT_ACCESS_SECRET=GERE_UM_SECRET_FORTE_AQUI_64_CHARS
JWT_REFRESH_SECRET=OUTRO_SECRET_FORTE_DIFERENTE_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (para 2FA secrets, etc.)
ENCRYPTION_KEY=CHAVE_DE_32_BYTES_EM_HEX

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OAuth GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Rate Limit
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Super Admin (criado pelo seed)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Super Admin