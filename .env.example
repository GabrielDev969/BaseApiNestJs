# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# CORS allowlist (comma-separated). REQUIRED in production; startup fails if missing.
# In dev/test, leaving this unset reflects the request Origin (allows any origin with credentials).
# CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=workspace_db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workspace_db?schema=public

# Postgres pool tuning (defaults below).
# DB_POOL_MAX:              max concurrent connections per process.
# DB_POOL_IDLE_MS:          ms before an idle connection is closed. Keep this
#                           comfortably above the inter-request gap so a hot pool
#                           doesn't recycle connections constantly under load.
# DB_POOL_CONN_TIMEOUT_MS:  ms a request will wait for a free connection before
#                           failing fast. Must be well under the upstream client
#                           timeout (ALB default = 60s) so the API can return
#                           503 itself instead of being killed mid-flight.
# DB_POOL_MAX=10
# DB_POOL_IDLE_MS=600000
# DB_POOL_CONN_TIMEOUT_MS=10000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# Trust proxy (Express). REQUIRED behind ALB / Cloudflare / Nginx so req.ip
# reflects the real client. Otherwise rate limit + IP allowlist are useless.
#   unset / 'false' -> off (dev default)
#   'true'          -> trust ALL forwarded hops (only behind a single trusted proxy)
#   '1', '2', ...   -> trust exactly N hops (more secure; matches your topology)
# TRUST_PROXY=1

# JWT access token (RS256) with rotating key set. Base64-encoded PEM keys.
# JWT_ACCESS_CURRENT_KID         — kid of the key currently used to sign new tokens.
# JWT_ACCESS_PRIVATE_KEY_CURRENT — base64-encoded PEM private key matching JWT_ACCESS_CURRENT_KID.
# JWT_ACCESS_PUBLIC_KEYS         — JSON object { "<kid>": "<base64-pem>", ... } of every kid still accepted
#                                  for verification (current + previous quarter overlap).
# Issued tokens carry the active kid in the JWS header. Verification looks the kid up in the map and
# accepts the token if the signature matches. JWKS is published at /.well-known/jwks.json.
# Rotation: add new pub to JWT_ACCESS_PUBLIC_KEYS → deploy. Swap CURRENT_KID + PRIVATE_KEY_CURRENT → deploy.
# After ≥ JWT_ACCESS_EXPIRES_IN, drop the old kid from the map → deploy.
# Generate a fresh keypair with:
#   node -e "const c=require('crypto');const k=c.generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log('PRIV:',Buffer.from(k.privateKey).toString('base64'));console.log('PUB:',Buffer.from(k.publicKey).toString('base64'))"
# Refresh tokens are opaque 64-byte hex (not JWT) and live as sha256 hashes in the Session table — no key needed.
JWT_ACCESS_CURRENT_KID=2026-q2
JWT_ACCESS_PRIVATE_KEY_CURRENT=replace-with-base64-encoded-pem-private-key
JWT_ACCESS_PUBLIC_KEYS={"2026-q2":"replace-with-base64-encoded-pem-public-key"}
JWT_ACCESS_EXPIRES_IN=15m

# Encryption key for 2FA secrets and other sensitive fields.
# Must be exactly 64 hex characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-chars

# OAuth — Google. Leave blank to disable Google login.
# The callback URL must match what is registered in the Google Cloud Console.
# The frontend typically owns this path and forwards { code, state } to POST /api/v1/auth/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback

# OAuth — GitHub. Leave blank to disable GitHub login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/oauth/github/callback

# Rate limiting (global)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Prometheus /metrics scrape allowlist (comma-separated IPs).
# REQUIRED in production; startup fails if unset.
# Default deny: when unset/empty, /metrics returns 403 (even in dev).
# Set the loopback + your Prometheus scraper IP.
METRICS_ALLOWED_IPS=127.0.0.1,::1

# Retention windows (days) for the daily maintenance sweep at 03:00.
# Sessions: hard-deleted N days after expiresAt (refresh token TTL is 7d).
# Audit logs: hard-deleted N days after createdAt. Match this to legal/compliance needs.
# Ephemeral tokens (EmailVerify, PasswordReset): hard-deleted N days after expiresAt.
# SESSION_RETENTION_DAYS=30
# AUDIT_RETENTION_DAYS=365
# EPHEMERAL_TOKEN_RETENTION_DAYS=7

# Password reuse policy: block the last N passwords (current + previous N-1).
# 0 disables the check entirely. Max 50.
# PASSWORD_HISTORY_SIZE=5

# Grafana admin credentials (used by docker-compose grafana service).
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin

# Email (Resend in prod, log-only in dev/test).
EMAIL_PROVIDER=log
EMAIL_FROM=Workspace API <noreply@example.com>
# RESEND_API_KEY=re_...
# Override the URL used in email links (verify-email, password-reset, invitation accept).
# Defaults to APP_URL.
# APP_PUBLIC_URL=https://app.example.com

# Discord webhook for Alertmanager. Required if you run the alertmanager container.
# Get it from Server Settings -> Integrations -> Webhooks.
# ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Logging
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent
# Defaults: debug (dev) / info (prod) / silent (test)
# LOG_LEVEL=info
# LOG_PRETTY: true uses pino-pretty (human-readable). Set false in containers to ship raw JSON.
# LOG_PRETTY=true
LOG_SLOW_REQUEST_MS=1000
LOG_SLOW_QUERY_MS=100

# Super admin — provisioned by `pnpm exec prisma db seed`.
# The seed creates a workspace with slug "__admin__" and a SuperAdmin role with all permissions.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Super Admin
